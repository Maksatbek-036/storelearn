@model Book
@{
    ViewData["Title"] =Model.Title;
}

<h2>@Model.Title</h2>
<p style="font-weight: bold;">Author: @Model.Author</p>
<p>@Model.Description</p>
<p>Price: @Model.Price</p>
<form action="@Url.Action("AddBook","Order")" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-outline-success my-2 ">В корзину</button>
</form>
