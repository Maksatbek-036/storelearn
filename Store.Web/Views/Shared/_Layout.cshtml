<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - интернет магазин на с#</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Store.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white ">
            <a class="navbar-brand m-1" asp-area="" asp-action="Index" asp-controller="Home">Интернет-магазин на C#</a>
            <form class="d-inline-flex m-1 my-lg-0" action="@Url.Action("Index", "Search")">
                <input class="form-control m-1 mr-sm-2" type="text" placeholder="Автор или название" name="query" />

                <button class="btn btn-outline-success my-2 " type="submit">Поиск</button>
            </form>

            <span class="navbar-text ml-auto">
                @{
                        

                    if (Context.Session.TryGetCart(out Cart cart) && cart.TotalCount>0)
                    {
                       <span href="">Товаров в корзине: @cart.TotalCount, на сумму @Convert.ToDouble(cart.TotalPrice)</span>
                    }

                   
                    else
                    {
                       @:Корзина пуста 
                    }
                }
            </span>
        </nav>
    </header>
    <div class="container">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Store.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
